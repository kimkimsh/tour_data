# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용. 클라이언트 번들 유입 금지

# ── 한국관광공사 OpenAPI ──────────────────────────────────
# ★ 반드시 "일반 인증키(Decoding)"를 넣는다.
#   Encoding 키를 넣으면 URLSearchParams 가 다시 인코딩해서 %2B → %252B 가 되고
#   서버가 resultCode 30 (등록되지 않은 서비스키)로 거절한다. 가장 흔한 실패다.
KTO_SERVICE_KEY_DECODING=

# ── 운영 ─────────────────────────────────────────────────
REVALIDATE_SECRET=                  # 수집 후 캐시 무효화 POST 인증용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 데이터 원천 선택 ─────────────────────────────────────
# supabase : data_snapshots 테이블에서 읽는다 (기본값, 배포 환경)
# fixtures : content/generated/*.json 파일에서 읽는다
#            Supabase 프로젝트 없이 화면을 띄울 때만 쓴다.
#            이 모드에서는 방문자 제보 등록이 동작하지 않는다.
# 값을 비우면: NEXT_PUBLIC_SUPABASE_URL 이 있으면 supabase, 없으면 fixtures.
MODU_DATA_SOURCE=

# 관리자는 환경변수가 아니라 admin_users 테이블로 지정한다 (docs/spec/04_data_model.md §5.1).
# 배포 후 SQL 로 한 줄 넣는다:
#   insert into admin_users (user_id, email) values ('<auth.users의 uuid>', '<이메일>');
