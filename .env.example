# ── Supabase ─────────────────────────────────────────────
# 대시보드는 이제 Publishable key(sb_publishable_...) 와 Secret key(sb_secret_...) 를
# 보여준다. 옛 anon / service_role JWT 는 같은 화면의 Legacy API keys 안에 있고
# 2026년 말까지 동작한다. 어느 쪽을 넣어도 되고, 역할 매핑(anon / service_role)은 같아서
# supabase/migrations/ 의 권한 설정은 그대로 쓴다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 클라이언트 번들 유입 금지.
# Settings > API Keys > Secret keys > Create new secret key — 만든 직후 한 번만 전체가 보인다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 한국관광공사 OpenAPI ──────────────────────────────────
# ★ 반드시 "일반 인증키(Decoding)"를 넣는다.
#   Encoding 키를 넣으면 URLSearchParams 가 다시 인코딩해서 %2B → %252B 가 되고
#   서버가 resultCode 30 (등록되지 않은 서비스키)로 거절한다. 가장 흔한 실패다.
KTO_SERVICE_KEY_DECODING=

# ── 운영 ─────────────────────────────────────────────────
REVALIDATE_SECRET=                  # 수집 후 캐시 무효화 POST 인증용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 데이터 원천 선택 ─────────────────────────────────────
# supabase : data_snapshots 테이블에서 읽는다 (기본값, 배포 환경)
# fixtures : content/generated/*.json 파일에서 읽는다
#            Supabase 프로젝트 없이 화면을 띄울 때만 쓴다.
#            이 모드에서는 방문자 제보 등록이 동작하지 않는다.
# 값을 비우면: NEXT_PUBLIC_SUPABASE_URL 이 있으면 supabase, 없으면 fixtures.
MODU_DATA_SOURCE=

# 관리자는 환경변수가 아니라 admin_users 테이블로 지정한다 (docs/spec/04_data_model.md §5.1).
# 배포 후 SQL 로 한 줄 넣는다:
#   insert into admin_users (user_id, email) values ('<auth.users의 uuid>', '<이메일>');

# ── 네이버 지도 (NAVER Cloud Platform · Maps) ──────────────────
# Client ID 만 넣는다. 브라우저가 내려받는 스크립트 주소에 그대로 실리므로 비밀이 아니고,
# 실제로 키를 제한하는 것은 NCP 콘솔의 Application > Web 서비스 URL 목록이다.
# 개발용 http://localhost:3000 과 배포 도메인을 모두 등록해야 타일이 뜬다.
# 값이 비어 있으면 지도 자리에 「지도를 불러오지 못했습니다」가 뜨고 나머지는 그대로 동작한다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
